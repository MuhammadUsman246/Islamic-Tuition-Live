<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If requesting a real file or folder in root, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. If requesting a file that exists inside /dist/, rewrite directly to dist/
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f [OR]
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 3. If file exists in dist without DOCUMENT_ROOT prefix check
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteCond dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 4. Fallback all remaining SPA routes to dist/index.html (or index.html)
  RewriteCond %{REQUEST_URI} !^/dist/
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# MIME Types to prevent Strict MIME errors
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest .json
</IfModule>

# Security & CORS Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
